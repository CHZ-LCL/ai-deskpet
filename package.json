{
  "name": "ai-deskpet",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ai",
    "pet",
    "deskpet",
    "live2d",
    "vrm",
    "ollama",
    "chat",
    "copilot"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-name/ai-deskpet.git"
  },
  "bugs": {
    "url": "https://github.com/your-name/ai-deskpet/issues"
  },
  "homepage": "https://github.com/your-name/ai-deskpet#readme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deskpet",
          "title": "%container.deskpet.title%",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "deskpet": [
        {
          "type": "webview",
          "id": "deskpet.petView",
          "name": "%view.deskpet.petView.name%",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "deskpet.openPanel",
        "title": "%command.openPanel.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.focus",
        "title": "%command.focus.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.chat",
        "title": "%command.chat.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.explainSelection",
        "title": "%command.explainSelection.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.teachSelection",
        "title": "%command.teachSelection.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.fixSelection",
        "title": "%command.fixSelection.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.explainDiagnostic",
        "title": "%command.explainDiagnostic.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.fixDiagnostic",
        "title": "%command.fixDiagnostic.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.fixAll",
        "title": "%command.fixAll.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.undoLastFix",
        "title": "%command.undoLastFix.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.fixHistory",
        "title": "%command.fixHistory.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.rewriteFile",
        "title": "%command.rewriteFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.checkCapability",
        "title": "%command.checkCapability.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.analyzeFailure",
        "title": "%command.analyzeFailure.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.analyzeClipboard",
        "title": "%command.analyzeClipboard.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.reviewFile",
        "title": "%command.reviewFile.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.reviewRules",
        "title": "%command.reviewRules.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.modernize",
        "title": "%command.modernize.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.inlineChat",
        "title": "%command.inlineChat.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.quickSetup",
        "title": "%command.quickSetup.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.refactorSelection",
        "title": "%command.refactorSelection.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.addTests",
        "title": "%command.addTests.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.generateDocs",
        "title": "%command.generateDocs.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.exportTheme",
        "title": "%command.exportTheme.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.importTheme",
        "title": "%command.importTheme.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.clearWorkspaceTheme",
        "title": "%command.clearWorkspaceTheme.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.checkDocs",
        "title": "%command.checkDocs.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.commitMessage",
        "title": "%command.commitMessage.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.searchDocs",
        "title": "%command.searchDocs.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.importModel",
        "title": "%command.importModel.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.importSound",
        "title": "%command.importSound.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.setApiKey",
        "title": "%command.setApiKey.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.resetPet",
        "title": "%command.resetPet.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.reindex",
        "title": "%command.reindex.title%",
        "category": "%command.category%"
      },
      {
        "command": "deskpet.openSettings",
        "title": "%command.openSettings.title%",
        "category": "%command.category%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deskpet.importModel",
          "when": "view == deskpet.petView",
          "group": "navigation@1"
        },
        {
          "command": "deskpet.openPanel",
          "when": "view == deskpet.petView",
          "group": "navigation@2"
        },
        {
          "command": "deskpet.openSettings",
          "when": "view == deskpet.petView",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "deskpet.inlineChat",
          "group": "deskpet@0"
        },
        {
          "command": "deskpet.explainSelection",
          "when": "editorHasSelection",
          "group": "deskpet@1"
        },
        {
          "command": "deskpet.teachSelection",
          "when": "editorHasSelection",
          "group": "deskpet@2"
        },
        {
          "command": "deskpet.fixSelection",
          "when": "editorHasSelection",
          "group": "deskpet@3"
        },
        {
          "command": "deskpet.explainDiagnostic",
          "group": "deskpet@4"
        },
        {
          "command": "deskpet.fixDiagnostic",
          "group": "deskpet@5"
        },
        {
          "command": "deskpet.fixAll",
          "group": "deskpet@5b"
        },
        {
          "command": "deskpet.rewriteFile",
          "group": "deskpet@5c"
        },
        {
          "command": "deskpet.reviewFile",
          "group": "deskpet@6"
        },
        {
          "command": "deskpet.addTests",
          "when": "editorHasSelection",
          "group": "deskpet@7"
        },
        {
          "command": "deskpet.generateDocs",
          "group": "deskpet@8"
        },
        {
          "command": "deskpet.checkDocs",
          "group": "deskpet@9"
        }
      ],
      "commandPalette": [
        {
          "command": "deskpet.focus",
          "when": "view == deskpet.petView"
        }
      ]
    },
    "keybindings": [
      {
        "command": "deskpet.chat",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "deskpet.inlineChat",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "deskpet.explainSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "deskpet.pet.name": {
          "type": "string",
          "default": "小豆",
          "description": "%config.pet.name.description%"
        },
        "deskpet.pet.renderer": {
          "type": "string",
          "enum": [
            "builtin",
            "image",
            "live2d",
            "vrm"
          ],
          "enumDescriptions": [
            "%config.pet.renderer.enum.0%",
            "%config.pet.renderer.enum.1%",
            "%config.pet.renderer.enum.2%",
            "%config.pet.renderer.enum.3%"
          ],
          "default": "builtin",
          "description": "%config.pet.renderer.description%"
        },
        "deskpet.pet.modelPath": {
          "type": "string",
          "default": "",
          "description": "%config.pet.modelPath.description%"
        },
        "deskpet.pet.cubismCorePath": {
          "type": "string",
          "default": "",
          "description": "%config.pet.cubismCorePath.description%"
        },
        "deskpet.pet.scale": {
          "type": "number",
          "default": 1,
          "minimum": 0.3,
          "maximum": 3,
          "description": "%config.pet.scale.description%"
        },
        "deskpet.pet.volume": {
          "type": "number",
          "default": 0.6,
          "minimum": 0,
          "maximum": 1,
          "description": "%config.pet.volume.description%"
        },
        "deskpet.pet.tts": {
          "type": "boolean",
          "default": false,
          "description": "%config.pet.tts.description%"
        },
        "deskpet.pet.ttsRate": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "%config.pet.ttsRate.description%"
        },
        "deskpet.pet.showOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "%config.pet.showOnStartup.description%"
        },
        "deskpet.pet.breakReminderMinutes": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "description": "%config.pet.breakReminderMinutes.description%"
        },
        "deskpet.pet.reactOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.pet.reactOnSave.description%"
        },
        "deskpet.pet.reactOnError": {
          "type": "boolean",
          "default": true,
          "description": "%config.pet.reactOnError.description%"
        },
        "deskpet.pet.interruption": {
          "type": "string",
          "enum": [
            "quiet",
            "balanced",
            "chatty"
          ],
          "enumDescriptions": [
            "%config.pet.interruption.enum.0%",
            "%config.pet.interruption.enum.1%",
            "%config.pet.interruption.enum.2%"
          ],
          "default": "balanced",
          "description": "%config.pet.interruption.description%"
        },
        "deskpet.teach.depth": {
          "type": "string",
          "enum": [
            "line",
            "logic",
            "design"
          ],
          "enumDescriptions": [
            "%config.teach.depth.enum.0%",
            "%config.teach.depth.enum.1%",
            "%config.teach.depth.enum.2%"
          ],
          "default": "line",
          "description": "%config.teach.depth.description%"
        },
        "deskpet.ai.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai",
            "vscode-lm"
          ],
          "enumDescriptions": [
            "%config.ai.provider.enum.0%",
            "%config.ai.provider.enum.1%",
            "%config.ai.provider.enum.2%"
          ],
          "default": "ollama",
          "description": "%config.ai.provider.description%"
        },
        "deskpet.ai.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434/v1",
          "description": "%config.ai.baseUrl.description%"
        },
        "deskpet.ai.model": {
          "type": "string",
          "default": "qwen2.5-coder:14b",
          "description": "%config.ai.model.description%"
        },
        "deskpet.ai.temperature": {
          "type": "number",
          "default": 0.6,
          "minimum": 0,
          "maximum": 2,
          "description": "%config.ai.temperature.description%"
        },
        "deskpet.ai.maxTokens": {
          "type": "number",
          "default": 2048,
          "minimum": 128,
          "description": "%config.ai.maxTokens.description%"
        },
        "deskpet.ai.extraInstructions": {
          "type": "string",
          "default": "",
          "description": "%config.ai.extraInstructions.description%"
        },
        "deskpet.docs.searchProvider": {
          "type": "string",
          "enum": [
            "none",
            "tavily",
            "serper"
          ],
          "enumDescriptions": [
            "%config.docs.searchProvider.enum.0%",
            "%config.docs.searchProvider.enum.1%",
            "%config.docs.searchProvider.enum.2%"
          ],
          "default": "none",
          "description": "%config.docs.searchProvider.description%"
        },
        "deskpet.context.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.context.enabled.description%"
        },
        "deskpet.context.maxFiles": {
          "type": "number",
          "default": 4000,
          "minimum": 100,
          "maximum": 20000,
          "description": "%config.context.maxFiles.description%"
        },
        "deskpet.context.maxChars": {
          "type": "number",
          "default": 8000,
          "minimum": 1000,
          "maximum": 30000,
          "description": "%config.context.maxChars.description%"
        },
        "deskpet.fix.autoDiff": {
          "type": "boolean",
          "default": true,
          "description": "%config.fix.autoDiff.description%"
        },
        "deskpet.fix.maxAutoDiagnostics": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 20,
          "description": "%config.fix.maxAutoDiagnostics.description%"
        },
        "deskpet.verify.afterEdit": {
          "type": "boolean",
          "default": true,
          "description": "%config.verify.afterEdit.description%"
        },
        "deskpet.verify.dependents": {
          "type": "boolean",
          "default": true,
          "description": "%config.verify.dependents.description%"
        },
        "deskpet.rewrite.maxLines": {
          "type": "number",
          "default": 1200,
          "minimum": 200,
          "maximum": 5000,
          "description": "%config.rewrite.maxLines.description%"
        },
        "deskpet.rewrite.maxChars": {
          "type": "number",
          "default": 48000,
          "minimum": 10000,
          "maximum": 200000,
          "description": "%config.rewrite.maxChars.description%"
        },
        "deskpet.debug.watchTerminal": {
          "type": "boolean",
          "default": true,
          "description": "%config.debug.watchTerminal.description%"
        },
        "deskpet.standards.packs": {
          "type": "array",
          "default": [
            "js-modern",
            "security",
            "consistency"
          ],
          "items": {
            "type": "string",
            "enum": [
              "js-modern",
              "ts-strict",
              "react",
              "python-modern",
              "security",
              "consistency"
            ]
          },
          "description": "%config.standards.packs.description%"
        },
        "deskpet.standards.custom": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "guidance"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "%config.standards.custom.id.description%"
              },
              "title": {
                "type": "string",
                "description": "%config.standards.custom.title.description%"
              },
              "guidance": {
                "type": "string",
                "description": "%config.standards.custom.guidance.description%"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ],
                "default": "medium"
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%config.standards.custom.languages.description%"
              }
            }
          },
          "description": "%config.standards.custom.description%"
        },
        "deskpet.standards.whitelist": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "rule"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "description": "%config.standards.whitelist.rule.description%"
              },
              "glob": {
                "type": "string",
                "description": "%config.standards.whitelist.glob.description%"
              },
              "reason": {
                "type": "string",
                "description": "%config.standards.whitelist.reason.description%"
              }
            }
          },
          "description": "%config.standards.whitelist.description%"
        },
        "deskpet.style.indent": {
          "type": "string",
          "enum": [
            "auto",
            "2",
            "4",
            "tab"
          ],
          "default": "auto",
          "description": "%config.style.indent.description%"
        },
        "deskpet.style.quotes": {
          "type": "string",
          "enum": [
            "auto",
            "single",
            "double"
          ],
          "default": "auto",
          "description": "%config.style.quotes.description%"
        },
        "deskpet.style.semicolons": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "description": "%config.style.semicolons.description%"
        },
        "deskpet.inline.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "%config.inline.codeLens.description%"
        },
        "deskpet.ui.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "enumDescriptions": [
            "%config.ui.language.enum.0%",
            "%config.ui.language.enum.1%",
            "English"
          ],
          "default": "auto",
          "description": "%config.ui.language.description%"
        },
        "deskpet.ui.theme": {
          "type": "string",
          "enum": [
            "auto",
            "mint",
            "sakura",
            "cyber",
            "mono",
            "amber",
            "ocean",
            "custom"
          ],
          "enumDescriptions": [
            "%config.ui.theme.enum.0%",
            "%config.ui.theme.enum.1%",
            "%config.ui.theme.enum.2%",
            "%config.ui.theme.enum.3%",
            "%config.ui.theme.enum.4%",
            "%config.ui.theme.enum.5%",
            "%config.ui.theme.enum.6%",
            "%config.ui.theme.enum.7%"
          ],
          "default": "mint",
          "description": "%config.ui.theme.description%"
        },
        "deskpet.ui.accent": {
          "type": "string",
          "default": "#4ec9b0",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "%config.ui.accent.description%"
        },
        "deskpet.ui.background": {
          "type": "string",
          "enum": [
            "grid",
            "plain",
            "none"
          ],
          "enumDescriptions": [
            "%config.ui.background.enum.0%",
            "%config.ui.background.enum.1%",
            "%config.ui.background.enum.2%"
          ],
          "default": "grid",
          "description": "%config.ui.background.description%"
        },
        "deskpet.ui.motion": {
          "type": "string",
          "enum": [
            "full",
            "lite",
            "off"
          ],
          "enumDescriptions": [
            "%config.ui.motion.enum.0%",
            "%config.ui.motion.enum.1%",
            "%config.ui.motion.enum.2%"
          ],
          "default": "full",
          "description": "%config.ui.motion.description%"
        },
        "deskpet.ui.density": {
          "type": "string",
          "enum": [
            "compact",
            "cozy",
            "comfortable"
          ],
          "enumDescriptions": [
            "%config.ui.density.enum.0%",
            "%config.ui.density.enum.1%",
            "%config.ui.density.enum.2%"
          ],
          "default": "cozy",
          "description": "%config.ui.density.description%"
        },
        "deskpet.ui.nameplate": {
          "type": "boolean",
          "default": true,
          "description": "%config.ui.nameplate.description%"
        },
        "deskpet.ui.quickActions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "%config.ui.quickActions.label.description%"
              },
              "command": {
                "type": "string",
                "description": "%config.ui.quickActions.command.description%"
              },
              "text": {
                "type": "string",
                "description": "%config.ui.quickActions.text.description%"
              }
            }
          },
          "description": "%config.ui.quickActions.description%"
        },
        "deskpet.ui.customCss": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "description": "%config.ui.customCss.description%"
        },
        "deskpet.pet.userName": {
          "type": "string",
          "default": "",
          "description": "%config.pet.userName.description%"
        },
        "deskpet.pet.tone": {
          "type": "string",
          "enum": [
            "warm",
            "sharp",
            "concise",
            "chuuni"
          ],
          "enumDescriptions": [
            "%config.pet.tone.enum.0%",
            "%config.pet.tone.enum.1%",
            "%config.pet.tone.enum.2%",
            "%config.pet.tone.enum.3%"
          ],
          "default": "warm",
          "description": "%config.pet.tone.description%"
        },
        "deskpet.pet.greeting": {
          "type": "string",
          "default": "",
          "description": "%config.pet.greeting.description%"
        },
        "deskpet.ai.replyLength": {
          "type": "string",
          "enum": [
            "short",
            "normal",
            "detailed"
          ],
          "default": "normal",
          "description": "%config.ai.replyLength.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node tests/run-unit.mjs",
    "test:integration": "node tests/run-integration.mjs",
    "test:visual": "node tests/run-visual.mjs",
    "lint": "tsc --noEmit -p .",
