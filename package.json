{
  "name": "ai-deskpet",
  "displayName": "AI 桌宠 · DeskPet",
  "description": "会陪你写代码的 AI 桌宠：对话、代码指导、查资料，支持 Live2D / 3D / 图片形象与自定义音效。",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ai",
    "pet",
    "deskpet",
    "live2d",
    "vrm",
    "ollama",
    "chat",
    "copilot"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-name/ai-deskpet.git"
  },
  "bugs": {
    "url": "https://github.com/your-name/ai-deskpet/issues"
  },
  "homepage": "https://github.com/your-name/ai-deskpet#readme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deskpet",
          "title": "AI 桌宠",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "deskpet": [
        {
          "type": "webview",
          "id": "deskpet.petView",
          "name": "桌宠",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "deskpet.openPanel",
        "title": "在编辑器标签中打开桌宠",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.focus",
        "title": "聚焦桌宠面板",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.chat",
        "title": "和桌宠聊天…",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.explainSelection",
        "title": "讲解选中代码",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.teachSelection",
        "title": "当老师讲透这段代码（逐行 / 逻辑 / 设计）",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.fixSelection",
        "title": "诊断并修复选中代码",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.explainDiagnostic",
        "title": "解释这行报错（人话版）",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.fixDiagnostic",
        "title": "修复这行报错…",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.analyzeFailure",
        "title": "分析最近一次命令失败",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.analyzeClipboard",
        "title": "分析剪贴板里的报错 / 堆栈",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.reviewFile",
        "title": "体检当前文件（逻辑漏洞检查）",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.reviewRules",
        "title": "按团队规范检查当前文件",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.modernize",
        "title": "现代化重构选中代码",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.inlineChat",
        "title": "行内对话（在代码旁提问 / 重构）",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.quickSetup",
        "title": "快速配置 AI（自动检测本机模型）",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.refactorSelection",
        "title": "重构选中代码",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.addTests",
        "title": "为选中代码生成单元测试（含边界用例）",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.generateDocs",
        "title": "为函数 / 类生成文档注释",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.checkDocs",
        "title": "检查文档与签名是否同步",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.commitMessage",
        "title": "生成 Git 提交信息",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.searchDocs",
        "title": "查询资料 / 文档…",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.importModel",
        "title": "导入桌宠形象（Live2D / VRM / GLB / 图片）…",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.importSound",
        "title": "导入音效…",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.setApiKey",
        "title": "设置 AI 服务密钥…",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.resetPet",
        "title": "重置桌宠状态与好感度",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.reindex",
        "title": "重建项目索引",
        "category": "AI 桌宠"
      },
      {
        "command": "deskpet.openSettings",
        "title": "打开桌宠设置",
        "category": "AI 桌宠"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deskpet.importModel",
          "when": "view == deskpet.petView",
          "group": "navigation@1"
        },
        {
          "command": "deskpet.openPanel",
          "when": "view == deskpet.petView",
          "group": "navigation@2"
        },
        {
          "command": "deskpet.openSettings",
          "when": "view == deskpet.petView",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "deskpet.inlineChat",
          "group": "deskpet@0"
        },
        {
          "command": "deskpet.explainSelection",
          "when": "editorHasSelection",
          "group": "deskpet@1"
        },
        {
          "command": "deskpet.teachSelection",
          "when": "editorHasSelection",
          "group": "deskpet@2"
        },
        {
          "command": "deskpet.fixSelection",
          "when": "editorHasSelection",
          "group": "deskpet@3"
        },
        {
          "command": "deskpet.explainDiagnostic",
          "group": "deskpet@4"
        },
        {
          "command": "deskpet.fixDiagnostic",
          "group": "deskpet@5"
        },
        {
          "command": "deskpet.reviewFile",
          "group": "deskpet@6"
        },
        {
          "command": "deskpet.addTests",
          "when": "editorHasSelection",
          "group": "deskpet@7"
        },
        {
          "command": "deskpet.generateDocs",
          "group": "deskpet@8"
        },
        {
          "command": "deskpet.checkDocs",
          "group": "deskpet@9"
        }
      ],
      "commandPalette": [
        {
          "command": "deskpet.focus",
          "when": "view == deskpet.petView"
        }
      ]
    },
    "keybindings": [
      {
        "command": "deskpet.chat",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "deskpet.inlineChat",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "deskpet.explainSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "AI 桌宠",
      "properties": {
        "deskpet.pet.name": {
          "type": "string",
          "default": "小豆",
          "description": "桌宠的名字，会显示在对话气泡与提示中。"
        },
        "deskpet.pet.renderer": {
          "type": "string",
          "enum": [
            "builtin",
            "image",
            "live2d",
            "vrm"
          ],
          "enumDescriptions": [
            "内置矢量形象（无需素材）",
            "单张图片 / GIF",
            "Live2D 模型（model3.json）",
            "3D 模型（VRM / GLB）"
          ],
          "default": "builtin",
          "description": "桌宠形象类型。"
        },
        "deskpet.pet.modelPath": {
          "type": "string",
          "default": "",
          "description": "形象文件路径（绝对路径，或相对工作区根目录）。Live2D 请指向 .model3.json / .model.json。"
        },
        "deskpet.pet.cubismCorePath": {
          "type": "string",
          "default": "",
          "description": "Live2D Cubism Core 文件（live2dcubismcore.min.js）路径。该文件由 Live2D 官方提供，插件不内置。"
        },
        "deskpet.pet.scale": {
          "type": "number",
          "default": 1,
          "minimum": 0.3,
          "maximum": 3,
          "description": "形象缩放倍率。"
        },
        "deskpet.pet.volume": {
          "type": "number",
          "default": 0.6,
          "minimum": 0,
          "maximum": 1,
          "description": "音效音量。"
        },
        "deskpet.pet.tts": {
          "type": "boolean",
          "default": false,
          "description": "朗读桌宠的回复（使用系统语音合成）。"
        },
        "deskpet.pet.ttsRate": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 2,
          "description": "朗读语速。"
        },
        "deskpet.pet.showOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "启动 VS Code 时自动展开桌宠侧边栏。"
        },
        "deskpet.pet.breakReminderMinutes": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "description": "连续编码多少分钟后提醒休息，0 表示关闭。"
        },
        "deskpet.pet.reactOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存文件时桌宠做出反应。"
        },
        "deskpet.pet.reactOnError": {
          "type": "boolean",
          "default": true,
          "description": "代码出现错误时桌宠提醒你。"
        },
        "deskpet.pet.interruption": {
          "type": "string",
          "enum": [
            "quiet",
            "balanced",
            "chatty"
          ],
          "enumDescriptions": [
            "安静：所有主动提醒只写进对话，不弹气泡",
            "平衡：重要提醒才弹气泡，打字时自动静默",
            "话多：每次提醒都弹气泡"
          ],
          "default": "balanced",
          "description": "主动提醒的打扰程度。"
        },
        "deskpet.teach.depth": {
          "type": "string",
          "enum": [
            "line",
            "logic",
            "design"
          ],
          "enumDescriptions": [
            "逐行讲解：按行号讲清每一行",
            "逻辑梳理：按执行顺序拆步骤",
            "设计思路：为什么这样设计、怎么扩展"
          ],
          "default": "line",
          "description": "「当老师讲透这段代码」默认使用的讲解深度。"
        },
        "deskpet.ai.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai",
            "vscode-lm"
          ],
          "enumDescriptions": [
            "本机 Ollama（OpenAI 兼容接口）",
            "任意 OpenAI 兼容接口（OpenAI / DeepSeek / 通义千问 / vLLM 等）",
            "VS Code 语言模型 API（复用 Copilot 订阅）"
          ],
          "default": "ollama",
          "description": "AI 服务提供方。"
        },
        "deskpet.ai.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434/v1",
          "description": "OpenAI 兼容接口的 Base URL（需包含 /v1）。"
        },
        "deskpet.ai.model": {
          "type": "string",
          "default": "qwen2.5-coder:14b",
          "description": "模型名称。"
        },
        "deskpet.ai.temperature": {
          "type": "number",
          "default": 0.6,
          "minimum": 0,
          "maximum": 2,
          "description": "采样温度。"
        },
        "deskpet.ai.maxTokens": {
          "type": "number",
          "default": 2048,
          "minimum": 128,
          "description": "单次回复的最大 token 数。"
        },
        "deskpet.ai.extraInstructions": {
          "type": "string",
          "default": "",
          "description": "追加到系统提示词的人设/习惯设定。"
        },
        "deskpet.docs.searchProvider": {
          "type": "string",
          "enum": [
            "none",
            "tavily",
            "serper"
          ],
          "enumDescriptions": [
            "不联网搜索，仅直接抓取指定文档地址",
            "使用 Tavily 搜索（需密钥）",
            "使用 Serper.dev 搜索（需密钥）"
          ],
          "default": "none",
          "description": "资料查询使用的联网搜索服务。"
        },
        "deskpet.context.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用项目级上下文：索引整个代码库，提问时自动关联相邻模块、接口定义与命名约定。"
        },
        "deskpet.context.maxFiles": {
          "type": "number",
          "default": 4000,
          "minimum": 100,
          "maximum": 20000,
          "description": "建立索引时最多读取的文件数（按 VS Code 搜索排序）。大型仓库可适当调大。"
        },
        "deskpet.context.maxChars": {
          "type": "number",
          "default": 8000,
          "minimum": 1000,
          "maximum": 30000,
          "description": "每次提问附带的项目上下文最大字符数。上下文窗口小的模型建议调低到 4000~6000。"
        },
        "deskpet.fix.autoDiff": {
          "type": "boolean",
          "default": true,
          "description": "从报错/诊断生成修复时，自动打开修改前后的并排 diff。"
        },
        "deskpet.debug.watchTerminal": {
          "type": "boolean",
          "default": true,
          "description": "捕获终端里失败的命令输出（需要 VS Code 1.93+ 的 Shell Integration），用于分析报错。"
        },
        "deskpet.standards.packs": {
          "type": "array",
          "default": [
            "js-modern",
            "security",
            "consistency"
          ],
          "items": {
            "type": "string",
            "enum": [
              "js-modern",
              "ts-strict",
              "react",
              "python-modern",
              "security",
              "consistency"
            ]
          },
          "description": "启用的规范规则包。会写进每次代码生成的提示词，也用于本地扫描。"
        },
        "deskpet.standards.custom": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "guidance"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "规则 id，例如 no-console"
              },
              "title": {
                "type": "string",
                "description": "简短标题"
              },
              "guidance": {
                "type": "string",
                "description": "给模型的约束，写具体一些"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ],
                "default": "medium"
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "限定语言 id，留空表示全部"
              }
            }
          },
          "description": "团队自定义规则，会写进每次代码生成的提示词。"
        },
        "deskpet.standards.whitelist": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "rule"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "description": "规则 id，支持 security.* 这样的前缀"
              },
              "glob": {
                "type": "string",
                "description": "文件 glob，例如 **/test/**；留空表示所有文件"
              },
              "reason": {
                "type": "string",
                "description": "豁免原因，会展示给模型"
              }
            }
          },
          "description": "安全扫描白名单：命中的规则在这些文件里不再提示，也不会让模型去“修复”。"
        },
        "deskpet.style.indent": {
          "type": "string",
          "enum": [
            "auto",
            "2",
            "4",
            "tab"
          ],
          "default": "auto",
          "description": "生成代码的缩进。auto 表示跟随当前文件。"
        },
        "deskpet.style.quotes": {
          "type": "string",
          "enum": [
            "auto",
            "single",
            "double"
          ],
          "default": "auto",
          "description": "生成代码的引号风格。auto 表示跟随当前文件。"
        },
        "deskpet.style.semicolons": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "description": "生成代码是否加分号。auto 表示跟随当前文件。"
        },
        "deskpet.inline.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "在每个函数/方法上方显示「讲解 / 重构」的 CodeLens。"
        },
        "deskpet.ui.theme": {
          "type": "string",
          "enum": [
            "auto",
            "mint",
            "sakura",
            "cyber",
            "mono",
            "amber",
            "ocean",
            "custom"
          ],
          "enumDescriptions": [
            "跟随 VS Code 的强调色",
            "薄荷绿",
            "樱花粉",
            "霓虹紫",
            "极简灰",
            "琥珀橙",
            "深海蓝",
            "使用 deskpet.ui.accent 指定的主色"
          ],
          "default": "mint",
          "description": "桌宠面板的主题色板。"
        },
        "deskpet.ui.accent": {
          "type": "string",
          "default": "#4ec9b0",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "自定义主色（theme=custom 时生效），十六进制 #rrggbb。"
        },
        "deskpet.ui.background": {
          "type": "string",
          "enum": [
            "grid",
            "plain",
            "none"
          ],
          "enumDescriptions": [
            "网格纹理 + 渐变",
            "纯色渐变，无网格",
            "完全纯色，关闭光晕"
          ],
          "default": "grid",
          "description": "面板背景样式。"
        },
        "deskpet.ui.motion": {
          "type": "string",
          "enum": [
            "full",
            "lite",
            "off"
          ],
          "enumDescriptions": [
            "完整动效",
            "关闭呼吸/摆尾等持续动画",
            "关闭所有动画与过渡"
          ],
          "default": "full",
          "description": "桌宠动效强度。"
        },
        "deskpet.ui.density": {
          "type": "string",
          "enum": [
            "compact",
            "cozy",
            "comfortable"
          ],
          "enumDescriptions": [
            "紧凑",
            "标准",
            "宽松"
          ],
          "default": "cozy",
          "description": "对话区排版密度。"
        },
        "deskpet.ui.nameplate": {
          "type": "boolean",
          "default": true,
          "description": "在形象下方显示「名字 · 心情」名牌。"
        },
        "deskpet.ui.quickActions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "按钮文字"
              },
              "command": {
                "type": "string",
                "description": "点击后执行的命令 id"
              },
              "text": {
                "type": "string",
                "description": "点击后直接发送的文本；填 __docs__ 表示切换到查资料模式"
              }
            }
          },
          "description": "对话区快捷按钮。留空使用内置按钮组。"
        },
        "deskpet.ui.customCss": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "description": "追加到桌宠 webview 的自定义 CSS（仅作用于桌宠面板，最多 12000 字符）。"
        },
        "deskpet.pet.userName": {
          "type": "string",
          "default": "",
          "description": "桌宠怎么称呼你。留空则用「你」。"
        },
        "deskpet.pet.tone": {
          "type": "string",
          "enum": [
            "warm",
            "sharp",
            "concise",
            "chuuni"
          ],
          "enumDescriptions": [
            "温和、鼓励",
            "直接、犀利",
            "极简",
            "偶尔中二"
          ],
          "default": "warm",
          "description": "说话风格。"
        },
        "deskpet.pet.greeting": {
          "type": "string",
          "default": "",
